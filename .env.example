# ==============================================================================
# ÍNTEGRA - CONFIGURAÇÃO DE AMBIENTE UNIFICADA (FRONTEND + BACKEND ORACLE)
# ==============================================================================
# Copie este arquivo para ".env" na raiz do projeto.
# NUNCA insira credenciais reais no controle de versão.

# ─── FRONTEND (Vite / React Web) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3333

# ─── BACKEND (Node.js / Express) ──────────────────────────────────────────────
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── BANCO DE DADOS ORACLE ───────────────────────────────────────────────────
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Configurações do Pool de Conexões Oracle
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# ─── WEBAUTHN / BIOMETRIA REAL / PASSKEYS ─────────────────────────────────────
WEBAUTHN_RP_NAME="ÍNTEGRA - Plataforma de Embarque Digital"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

