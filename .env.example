# ==============================================================================
# ÍNTEGRA - CONFIGURAÇÃO DE AMBIENTE UNIFICADA (FRONTEND + BACKEND ORACLE)
# ==============================================================================
# Copie este arquivo para ".env" na raiz do projeto.
# NUNCA insira credenciais reais no controle de versão.

# ─── FRONTEND (Vite / React Web) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3333

# ─── MODO DE DEMONSTRAÇÃO (Opcional) ──────────────────────────────────────────
# Habilita atalhos de apresentação: botão de simular leitura de QR Code e
# aprovação de credenciais de exemplo. Desativado por padrão.
# Ative para gravar vídeo ou apresentar sem banco; nunca deixe ativo em
# publicação real, pois exibe embarque aprovado sem consulta ao sistema.
# VITE_DEMO_MODE=true

# ─── WHITE-LABEL DA OPERADORA (Opcional) ──────────────────────────────────────
# Sem estas variáveis, o app usa a operadora padrão (ClickBus) ou a identificada
# pelo subdomínio de acesso. Defina-as para publicar um build com outra marca.
# VITE_OPERATOR_ID=operadora
# VITE_OPERATOR_NAME="Nome da Operadora"
# VITE_OPERATOR_PRIMARY=#7B2CBF
# VITE_OPERATOR_PRIMARY_DARK=#5B1A9F
# VITE_OPERATOR_LOGO=/logo-operadora.png

# ─── BACKEND (Node.js / Express) ──────────────────────────────────────────────
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── BANCO DE DADOS ORACLE ───────────────────────────────────────────────────
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Configurações do Pool de Conexões Oracle
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# ─── WEBAUTHN / BIOMETRIA REAL / PASSKEYS ─────────────────────────────────────
WEBAUTHN_RP_NAME="ÍNTEGRA - Plataforma de Embarque Digital"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

