# ==============================================================================
# ÍNTEGRA - VARIÁVEIS DE AMBIENTE (TEMPLATE)
# ==============================================================================
# Copie este arquivo para ".env" na raiz do projeto e preencha com os 
# valores correspondentes ao seu ambiente (desenvolvimento, staging ou produção).
# ATENÇÃO: Nunca versione o arquivo .env contendo chaves reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMUNICAÇÃO COM O BACK-END (API)
# ------------------------------------------------------------------------------
# URL base onde o back-end está rodando. 
# Ex: http://localhost:3333 (dev) ou https://api.integra.clickbus.com (prod)
VITE_API_URL=http://localhost:3333

# Timeout padrão para requisições na API (em milissegundos)
VITE_API_TIMEOUT=10000

# ------------------------------------------------------------------------------
# 2. IDENTIFICAÇÃO WHITE-LABEL (OPERADORA)
# ------------------------------------------------------------------------------
# Slug identificador da operadora para carregar o tema visual dinamicamente.
# Valores comuns: clickbus, aguiabranca, viacaocometa, etc.
VITE_OPERATOR_ID=clickbus

# Chave pública/token de acesso restrito da operadora
VITE_OPERATOR_API_KEY=sua_chave_de_operadora_aqui

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES DE HARDWARE E SENSORES
# ------------------------------------------------------------------------------
# Habilita ou desabilita as funções de leitura de NFC no device.
# Útil deixar como 'false' caso esteja testando o PWA via web browser.
VITE_ENABLE_NFC_READER=true

# Habilita ou desabilita o fallback para câmera (leitura de QR Code).
VITE_ENABLE_QR_SCANNER=true
