# ==============================================================================
# ÍNTEGRA API - CONFIGURAÇÃO DE AMBIENTE (BACKEND & ORACLE DATABASE)
# ==============================================================================
# NUNCA insira credenciais reais neste arquivo.
# Copie este arquivo para ".env" ou utilize o ".env" unificado na raiz do projeto.

PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Credenciais Oracle Database
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Configurações do Pool de Conexões Oracle
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# Hashing de Senhas (Opcional - Padrão SHA256)
PASSWORD_HASH_ALGORITHM=SHA256

# WebAuthn / Passkeys / Biometria Oficial
WEBAUTHN_RP_NAME="ÍNTEGRA - Plataforma de Embarque Digital"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
